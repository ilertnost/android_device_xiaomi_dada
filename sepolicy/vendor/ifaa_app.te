# IFAAService talks to the vendor AIDL Mlipay service for fingerprint payment.
hal_client_domain(ifaa_app, hal_mlipay)
binder_call(ifaa_app, hal_mlipay_default)

# The stock IFAAService reads these fingerprint/payment properties.
get_prop(ifaa_app, vendor_fp_prop)
get_prop(ifaa_app, vendor_payment_security_prop)
