From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Fri, 17 Jul 2026 00:42:42 +0900
Subject: [PATCH 2/2] display: Force SDR STC during HDR for dada

Use the stock-like SDR STC color mode and render intent while HDR content
is present when persist.vendor.display.dada_sdr_stc_hdr is enabled.

Fall back to the current render intent if the stock intent is unavailable.
---
 sdmclient/Android.bp             |  1 +
 sdmclient/sdm_color_mode_stc.cpp | 45 ++++++++++++++++++++++++++++++++++++----
 2 files changed, 42 insertions(+), 4 deletions(-)

diff --git a/sdmclient/Android.bp b/sdmclient/Android.bp
index 9e07ee5917e9b69d35d64a71aed54546c69bdbea..8d040e3655d62e01f68990c9bafdb4c24a7a1745 100644
--- a/sdmclient/Android.bp
+++ b/sdmclient/Android.bp
@@ -23,6 +23,7 @@ cc_library_shared {
         "libsdmutils",
         "libdrm",
         "libtinyxml2",
+        "libbase",
     ],
     cflags: [
         "-DLOG_TAG=\"SDM\"",
diff --git a/sdmclient/sdm_color_mode_stc.cpp b/sdmclient/sdm_color_mode_stc.cpp
index f8d034b2f0b8ac954bcf77a8b5f6a4245142098a..655f096c31f1813d951aeb741004d9cae43ac30a 100644
--- a/sdmclient/sdm_color_mode_stc.cpp
+++ b/sdmclient/sdm_color_mode_stc.cpp
@@ -44,6 +44,8 @@
 #include <vector>
 #include <iomanip>
 
+#include <android-base/properties.h>
+
 #include "concurrency_mgr.h"
 #include "sdm_color_mode_stc.h"
 
@@ -302,10 +304,45 @@ SDMColorModeStc::ApplyCurrentColorModeWithRenderIntent(bool hdr_present) {
   }
 
   curr_dynamic_range_ = (hdr_present) ? kHdrType : kSdrType;
+
   int32_t ret = 0;
   snapdragoncolor::ColorMode mode;
-  ret = GetStcColorModeFromMap(current_color_mode_, current_render_intent_,
-                               curr_dynamic_range_, &mode);
+
+  SDMColorMode applied_color_mode = current_color_mode_;
+  SDMRenderIntent applied_render_intent = current_render_intent_;
+  DynamicRangeType applied_dynamic_range = curr_dynamic_range_;
+
+  const bool force_sdr_stc_hdr = android::base::GetBoolProperty(
+      "persist.vendor.display.dada_sdr_stc_hdr", false);
+
+  if (force_sdr_stc_hdr && hdr_present &&
+      current_color_mode_ == static_cast<SDMColorMode>(9)) {
+    applied_color_mode = static_cast<SDMColorMode>(7);
+    applied_render_intent = static_cast<SDMRenderIntent>(267);
+    applied_dynamic_range = kSdrType;
+
+    ret = GetStcColorModeFromMap(applied_color_mode, applied_render_intent,
+                                 applied_dynamic_range, &mode);
+    if (ret) {
+      DLOGW("dada: stock intent 267 unavailable, try SDR STC with current intent %d",
+            current_render_intent_);
+      applied_render_intent = current_render_intent_;
+      ret = GetStcColorModeFromMap(applied_color_mode, applied_render_intent,
+                                   applied_dynamic_range, &mode);
+      if (!ret) {
+        DLOGW("dada: force SDR STC during HDR, mode %d -> %d, intent %d",
+              current_color_mode_, applied_color_mode, applied_render_intent);
+      }
+    } else {
+      DLOGW("dada: force stock-like SDR STC during HDR, mode %d -> %d, intent %d -> %d",
+            current_color_mode_, applied_color_mode,
+            current_render_intent_, applied_render_intent);
+    }
+  } else {
+    ret = GetStcColorModeFromMap(applied_color_mode, applied_render_intent,
+                                 applied_dynamic_range, &mode);
+  }
+
   if (ret) {
     DLOGW("Cannot find mode for current_color_mode_ %d, current_render_intent_ "
           "%d, hdr_present %d",
@@ -316,8 +353,8 @@ SDMColorModeStc::ApplyCurrentColorModeWithRenderIntent(bool hdr_present) {
   DLOGI("Applying Stc mode (gamut %d gamma %d intent %d), curr mode %d, render "
         "intent %d, hdr "
         "present %d",
-        mode.gamut, mode.gamma, mode.intent, current_color_mode_,
-        current_render_intent_, hdr_present);
+        mode.gamut, mode.gamma, mode.intent, applied_color_mode,
+        applied_render_intent, hdr_present);
   error = display_intf_->SetStcColorMode(mode);
   if (error != kErrorNone) {
     DLOGE("Failed to apply Stc color mode: gamma %d gamut %d intent %d err %d",
