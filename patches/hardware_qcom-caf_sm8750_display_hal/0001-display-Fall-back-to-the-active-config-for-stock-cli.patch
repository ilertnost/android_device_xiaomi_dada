From 8b153b786bdcc2b40f66f84f2934b391545db12b Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Tue, 30 Jun 2026 09:28:57 +0900
Subject: [PATCH 1/2] display: Fall back to the active config for stock clients

Change-Id: I696351c8492ed3d6cfd4672ce17a341fe2168616
---
 composer/DisplayConfigAIDL.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/composer/DisplayConfigAIDL.cpp b/composer/DisplayConfigAIDL.cpp
index 3db51c0..418cbbd 100644
--- a/composer/DisplayConfigAIDL.cpp
+++ b/composer/DisplayConfigAIDL.cpp
@@ -213,8 +213,22 @@ ScopedAStatus DisplayConfigAIDL::getDisplayAttributes(int config_index, DisplayT
   error = settings_->GetDisplayAttributes(disp_id, config_index, &var_info);
 
   if (error != sdm::kErrorNone) {
-    ALOGW("%s: Invalid display = %d", __FUNCTION__, disp_id);
-    return ScopedAStatus(AStatus_fromExceptionCode(EX_ILLEGAL_ARGUMENT));
+    // Some stock clients cache a physical config index while SDM exposes
+    // virtual config IDs to SurfaceFlinger.  The current display attributes
+    // are the correct compatibility fallback for those clients.
+    sdm::Config active_config = -1;
+    error = settings_->GetActiveConfig(disp_id, &active_config);
+    if (error == sdm::kErrorNone) {
+      error = settings_->GetDisplayAttributes(disp_id, active_config, &var_info);
+    }
+
+    if (error != sdm::kErrorNone) {
+      ALOGW("%s: Invalid display = %d, config = %d", __FUNCTION__, disp_id, config_index);
+      return ScopedAStatus(AStatus_fromExceptionCode(EX_ILLEGAL_ARGUMENT));
+    }
+
+    ALOGW("%s: Remapped invalid config %d to active config %d for display %d", __FUNCTION__,
+          config_index, active_config, disp_id);
   }
 
   attributes->vsyncPeriod = var_info.vsync_period_ns;
