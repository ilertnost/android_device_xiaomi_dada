From 14520f139bac28a5e0cdb73dc6e50f0addb2a7da Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Sat, 26 Sep 2026 14:55:02 +0900
Subject: [PATCH] video: pick the vendor video enhancement filters in CCodec

CCodec consults the per-app allow lists in /system/etc and the debug.media.video.{frc,vpp,ve,ais} capability flags, then asks the Codec2 store for the RF (motion smoothing) or SR (AI super resolution) filter. The parameters are vendor.qti-ext-vpp-* / ext-mi-*, so the vendor codec2 side has to carry the filters.
---
 media/codec2/sfplugin/CCodec.cpp | 404 ++++++++++++++++++++++++++++++-
 1 file changed, 402 insertions(+), 2 deletions(-)

diff --git a/media/codec2/sfplugin/CCodec.cpp b/media/codec2/sfplugin/CCodec.cpp
index ea44e121d4..207db3d3e8 100644
--- a/media/codec2/sfplugin/CCodec.cpp
+++ b/media/codec2/sfplugin/CCodec.cpp
@@ -21,6 +21,7 @@
 #include <utils/Trace.h>
 
 #include <sstream>
+#include <stdlib.h>  // for getprogname
 #include <thread>
 
 #include <android_media_codec.h>
@@ -36,8 +37,10 @@
 #include <android/IOMXBufferSource.h>
 #include <android/hardware/media/omx/1.0/IGraphicBufferSource.h>
 #include <android/hardware/media/omx/1.0/IOmx.h>
+#include <android-base/file.h>
 #include <android-base/properties.h>
 #include <android-base/stringprintf.h>
+#include <android-base/strings.h>
 #include <cutils/properties.h>
 #include <gui/Flags.h> // Remove with mediaflagtools::
 #include <gui/IGraphicBufferProducer.h>
@@ -1101,6 +1104,389 @@ void AmendOutputFormatWithCodecSpecificData(
     }
 }
 
+/*
+ * Video enhancement (MEMC / AIE / AIS) support.
+ *
+ * Stock Xiaomi playback selects exactly one of three mutually exclusive QTI
+ * VPP features per session: FRC frame interpolation (MEMC), AIE image
+ * enhancement, or AIS AI super-resolution. Each is enabled by a fixed set of
+ * vendor parameters passed to the video decoder at configure time. Reproduce
+ * that here.
+ *
+ * This is strictly opt-in and fails closed: no requested mode, an ambiguous
+ * property combination, a missing support declaration, an unreadable
+ * allowlist, a non-QTI component or an ineligible stream all leave the
+ * configuration untouched.
+ */
+
+enum class VideoEnhancement {
+    None,
+    Memc,
+    Aie,
+    Ais,
+};
+
+constexpr char kVideoMemcAppListPath[] = "/system/etc/video_memc_apps.txt";
+constexpr char kVideoAieAppListPath[] = "/system/etc/video_aie_apps.txt";
+constexpr char kVideoAisAppListPath[] = "/system/etc/video_ais_apps.txt";
+
+constexpr char kVideoMemcSupportProperty[] = "ro.vendor.media.video.frc.support";
+constexpr char kVideoVppSupportProperty[] = "ro.vendor.media.video.vpp.support";
+constexpr char kVideoAieSupportProperty[] = "debug.config.media.video.aie.support";
+constexpr char kVideoAisSupportProperty[] = "debug.config.media.video.ais.support";
+
+constexpr char kVideoMemcToggleProperty[] = "debug.media.video.frc";
+constexpr char kVideoVppToggleProperty[] = "debug.media.video.vpp";
+constexpr char kVideoVeToggleProperty[] = "debug.media.video.ve";
+constexpr char kVideoAisToggleProperty[] = "debug.media.video.ais";
+
+constexpr size_t kVideoAppListMaxSize = 16 * 1024;  // bound what we parse
+constexpr size_t kVideoAppListMaxNameLength = 128;
+constexpr size_t kVideoAppListMaxCount = 256;
+
+// Reads one allowlist file. Blank lines and '#' comments are ignored.
+// Unreadable, oversized or empty content yields an empty set so that the
+// corresponding feature stays disabled.
+std::set<std::string> readVideoAppList(const char *path) {
+    std::string content;
+    if (!android::base::ReadFileToString(path, &content)) {
+        ALOGW("video enhancement: cannot read app list %s", path);
+        return {};
+    }
+    if (content.size() > kVideoAppListMaxSize) {
+        ALOGW("video enhancement: app list %s is larger than %zu bytes",
+              path, kVideoAppListMaxSize);
+        return {};
+    }
+    std::set<std::string> appList;
+    for (const std::string &rawLine : android::base::Split(content, "\n")) {
+        std::string app = android::base::Trim(rawLine);
+        if (app.empty() || app[0] == '#') {
+            continue;
+        }
+        if (app.size() > kVideoAppListMaxNameLength) {
+            ALOGW("video enhancement: ignoring malformed entry in app list %s", path);
+            continue;
+        }
+        if (appList.size() >= kVideoAppListMaxCount) {
+            ALOGW("video enhancement: app list %s exceeds %zu entries",
+                  path, kVideoAppListMaxCount);
+            break;
+        }
+        appList.insert(std::move(app));
+    }
+    if (appList.empty()) {
+        ALOGW("video enhancement: app list %s is empty", path);
+    }
+    return appList;
+}
+
+// Returns the allowlist for one feature, loaded from disk exactly once per
+// process. Every list has its own cache, and a failed load is cached as empty
+// (fail closed).
+const std::set<std::string> &getVideoAppList(VideoEnhancement feature) {
+    switch (feature) {
+        case VideoEnhancement::Memc: {
+            static const std::set<std::string> sList = readVideoAppList(kVideoMemcAppListPath);
+            return sList;
+        }
+        case VideoEnhancement::Aie: {
+            static const std::set<std::string> sList = readVideoAppList(kVideoAieAppListPath);
+            return sList;
+        }
+        case VideoEnhancement::Ais: {
+            static const std::set<std::string> sList = readVideoAppList(kVideoAisAppListPath);
+            return sList;
+        }
+        case VideoEnhancement::None: {
+            static const std::set<std::string> sEmpty;
+            return sEmpty;
+        }
+    }
+    static const std::set<std::string> sEmpty;
+    return sEmpty;
+}
+
+// Whether the selected feature may be applied in this process. Private
+// processes ("pkg:remote") match on their base package name.
+bool isVideoEnhancementAllowedProcess(VideoEnhancement feature) {
+    const char *progname = getprogname();
+    if (progname == nullptr) {
+        return false;
+    }
+    std::string process(progname);
+    size_t colon = process.find(':');
+    if (colon != std::string::npos) {
+        process.resize(colon);
+    }
+    if (process.empty()) {
+        return false;
+    }
+    return getVideoAppList(feature).count(process) != 0;
+}
+
+// Maps the runtime properties to at most one feature. The properties are read
+// on every call so that a runtime switch immediately affects newly configured
+// sessions. Only three exact combinations select a feature; anything else
+// (including two features requested at once) is rejected as ambiguous.
+VideoEnhancement getRequestedVideoEnhancement() {
+    const bool frc = android::base::GetBoolProperty(kVideoMemcToggleProperty, false);
+    const bool vpp = android::base::GetBoolProperty(kVideoVppToggleProperty, false);
+    const bool ve = android::base::GetBoolProperty(kVideoVeToggleProperty, false);
+    const bool ais = android::base::GetBoolProperty(kVideoAisToggleProperty, false);
+    if (!frc && !vpp && !ve && !ais) {
+        return VideoEnhancement::None;
+    }
+    if (frc && !vpp && !ve && !ais) {
+        return VideoEnhancement::Memc;
+    }
+    if (!frc && vpp && ve && !ais) {
+        return VideoEnhancement::Aie;
+    }
+    if (!frc && vpp && !ve && ais) {
+        return VideoEnhancement::Ais;
+    }
+    ALOGW("video enhancement: rejecting ambiguous property combination "
+          "(frc=%d vpp=%d ve=%d ais=%d)",
+          frc, vpp, ve, ais);
+    return VideoEnhancement::None;
+}
+
+// Stock support declarations: MEMC is gated on the FRC support flag alone,
+// AIE/AIS additionally require the VPP support flag and their own flag.
+bool isVideoEnhancementSupported(VideoEnhancement feature) {
+    switch (feature) {
+        case VideoEnhancement::Memc:
+            return android::base::GetBoolProperty(kVideoMemcSupportProperty, false);
+        case VideoEnhancement::Aie:
+            return android::base::GetBoolProperty(kVideoVppSupportProperty, false)
+                    && android::base::GetBoolProperty(kVideoAieSupportProperty, false);
+        case VideoEnhancement::Ais:
+            return android::base::GetBoolProperty(kVideoVppSupportProperty, false)
+                    && android::base::GetBoolProperty(kVideoAisSupportProperty, false);
+        case VideoEnhancement::None:
+            return false;
+    }
+    return false;
+}
+
+// Whether enhancement parameters should be added to this configuration, and
+// which single feature to apply. Returns its resolution through *width and
+// *height whenever a feature is selected.
+VideoEnhancement selectVideoEnhancement(
+        const std::shared_ptr<Codec2Client::Component> &comp,
+        const Config &config,
+        const sp<AMessage> &msg,
+        const AString &mime,
+        int32_t *width,
+        int32_t *height) {
+    const VideoEnhancement feature = getRequestedVideoEnhancement();
+    if (feature == VideoEnhancement::None) {
+        return VideoEnhancement::None;
+    }
+
+    // Only non-secure QTI video decoders have a VPP pipeline.
+    if ((config.mDomain & (Config::IS_VIDEO | Config::IS_DECODER))
+            != (Config::IS_VIDEO | Config::IS_DECODER)) {
+        return VideoEnhancement::None;
+    }
+    const std::string &codecName = comp->getName();
+    if (!android::base::StartsWith(codecName, "c2.qti.")
+            || codecName.find(".decoder") == std::string::npos
+            || codecName.find(".secure") != std::string::npos
+            || codecName.find(".low_latency") != std::string::npos) {
+        return VideoEnhancement::None;
+    }
+    if (!mime.equalsIgnoreCase(MIMETYPE_VIDEO_AVC)
+            && !mime.equalsIgnoreCase(MIMETYPE_VIDEO_HEVC)
+            && !mime.equalsIgnoreCase(MIMETYPE_VIDEO_VP9)
+            && !mime.equalsIgnoreCase(MIMETYPE_VIDEO_AV1)) {
+        return VideoEnhancement::None;
+    }
+    if (!isVideoEnhancementSupported(feature)) {
+        return VideoEnhancement::None;
+    }
+
+    // Never interfere with secure, protected or tunneled playback.
+    int32_t secure = 0;
+    int32_t protectedContent = 0;
+    int32_t tunneled = 0;
+    if ((msg->findInt32("secure", &secure) && secure != 0)
+            || (msg->findInt32("protected", &protectedContent) && protectedContent != 0)
+            || (msg->findInt32("feature-tunneled-playback", &tunneled) && tunneled != 0)
+            || config.mTunneled) {
+        return VideoEnhancement::None;
+    }
+
+    // Stock VPP features are disabled for HDR content (see android::videobox::isHDR()).
+    if (msg->contains(KEY_HDR_STATIC_INFO) || msg->contains(KEY_HDR10_PLUS_INFO)) {
+        return VideoEnhancement::None;
+    }
+    int32_t colorTransfer = 0;
+    int32_t colorStandard = 0;
+    if ((msg->findInt32(KEY_COLOR_TRANSFER, &colorTransfer)
+                && (colorTransfer == COLOR_TRANSFER_ST2084
+                    || colorTransfer == COLOR_TRANSFER_HLG))
+            || (msg->findInt32(KEY_COLOR_STANDARD, &colorStandard)
+                && colorStandard == COLOR_STANDARD_BT2020)) {
+        return VideoEnhancement::None;
+    }
+
+    // The VPP features are meant for regular SD/HD/UHD video content; each has
+    // its own resolution window.
+    int32_t w = 0;
+    int32_t h = 0;
+    if (!msg->findInt32(KEY_WIDTH, &w) || !msg->findInt32(KEY_HEIGHT, &h)) {
+        return VideoEnhancement::None;
+    }
+    if (w <= 0 || h <= 0) {
+        return VideoEnhancement::None;
+    }
+    const int32_t shortEdge = w < h ? w : h;
+    const int32_t longEdge = w < h ? h : w;
+    switch (feature) {
+        case VideoEnhancement::Memc:
+            if (shortEdge < 720 || longEdge > 3840) {
+                return VideoEnhancement::None;
+            }
+            break;
+        case VideoEnhancement::Aie:
+            // Stock checks each dimension against 96 and the sorted edges
+            // against 100/4096.
+            if (w < 96 || h < 96 || shortEdge < 100 || longEdge > 4096) {
+                return VideoEnhancement::None;
+            }
+            break;
+        case VideoEnhancement::Ais:
+            // AIS only upscales small content.
+            if (w < 96 || h < 96 || shortEdge < 100
+                    || longEdge > 1280 || shortEdge > 720) {
+                return VideoEnhancement::None;
+            }
+            break;
+        case VideoEnhancement::None:
+            return VideoEnhancement::None;
+    }
+
+    float frameRate = 0.0f;
+    int32_t intFrameRate = 0;
+    if (msg->findFloat(KEY_FRAME_RATE, &frameRate)) {
+        if (frameRate > 60.0f) {
+            return VideoEnhancement::None;
+        }
+    } else if (msg->findInt32(KEY_FRAME_RATE, &intFrameRate) && intFrameRate > 60) {
+        return VideoEnhancement::None;
+    }
+
+    if (!isVideoEnhancementAllowedProcess(feature)) {
+        return VideoEnhancement::None;
+    }
+
+    *width = w;
+    *height = h;
+    return feature;
+}
+
+const char *videoEnhancementName(VideoEnhancement feature) {
+    switch (feature) {
+        case VideoEnhancement::Memc:
+            return "MEMC";
+        case VideoEnhancement::Aie:
+            return "AIE";
+        case VideoEnhancement::Ais:
+            return "AIS";
+        case VideoEnhancement::None:
+            break;
+    }
+    return "none";
+}
+
+// Stock QTI VPP FRC parameters: manual VPP mode, smooth motion interpolation at
+// high level with 1x interpolation.
+void addVideoMemcParams(const sp<AMessage> &sdkParams) {
+    sdkParams->setInt32("vendor.qti-ext-vpp-lazy-init.on", 1);
+    sdkParams->setInt32("vendor.qti-ext-vpp-bypass.enable", 0);
+    sdkParams->setString("vendor.qti-ext-vpp.mode", "HQV_MODE_MANUAL");
+    sdkParams->setString("vendor.qti-ext-vpp-frc.mode", "FRC_MODE_SMOOTH_MOTION");
+    sdkParams->setString("vendor.qti-ext-vpp-frc.level", "FRC_LEVEL_HIGH");
+    sdkParams->setString("vendor.qti-ext-vpp-frc.interp", "FRC_INTERP_1X");
+    sdkParams->setInt32("vendor.qti-ext-vpp-frc.frame_copy_input", 0);
+    sdkParams->setInt32("vendor.qti-ext-vpp-frc.frame_copy_on_fallback", 0);
+    sdkParams->setInt32("vendor.qti-ext-vpp-frc.bypass_i_frame_num", 2);
+}
+
+// Stock QTI VPP AIE parameters: manual VPP mode with hue correction, LTM and
+// per-resolution quality levels bucketed by frame size (mirrors the
+// libvppvideobox table; the default bucket applies above 8843264 pixels).
+void addVideoAieParams(const sp<AMessage> &sdkParams, int32_t width, int32_t height) {
+    const int64_t pixels = (int64_t)width * (int64_t)height;
+    int32_t cadeLevel = 8;
+    int32_t aceBrightnessLow = 20;
+    int32_t aceStrength = 41;
+    int32_t satGainAndOffset = 60;
+    if (pixels <= 101376) {
+        cadeLevel = 6; aceBrightnessLow = 10; aceStrength = 35; satGainAndOffset = 55;
+    } else if (pixels <= 307200) {
+        cadeLevel = 7; aceBrightnessLow = 15; aceStrength = 36; satGainAndOffset = 55;
+    } else if (pixels <= 430080) {
+        cadeLevel = 8; aceBrightnessLow = 20; aceStrength = 37; satGainAndOffset = 55;
+    } else if (pixels <= 921600) {
+        cadeLevel = 8; aceBrightnessLow = 20; aceStrength = 38; satGainAndOffset = 55;
+    } else if (pixels <= 1421312) {
+        cadeLevel = 8; aceBrightnessLow = 20; aceStrength = 40; satGainAndOffset = 58;
+    } else if (pixels < 8843265) {
+        cadeLevel = 8; aceBrightnessLow = 20; aceStrength = 41; satGainAndOffset = 62;
+    }
+    sdkParams->setInt32("vendor.qti-ext-vpp-lazy-init.on", 1);
+    sdkParams->setString("vendor.qti-ext-vpp.mode", "HQV_MODE_MANUAL");
+    sdkParams->setInt32("vendor.qti-ext-vpp-bypass.enable", 0);
+    sdkParams->setInt32("vendor.ext-mi-aie-enable.value", 1);
+    sdkParams->setInt32("vendor.ext-mi-aie-bypass.value", 0);
+    sdkParams->setString("vendor.qti-ext-vpp-aie.mode", "HQV_MODE_MANUAL");
+    sdkParams->setString("vendor.qti-ext-vpp-aie.hue-mode", "HQV_HUE_MODE_ON");
+    sdkParams->setInt32("vendor.qti-ext-vpp-aie.ltm-level", 1);
+    sdkParams->setInt32("vendor.qti-ext-vpp-aie.ltm-ace-brightness-high", 0);
+    sdkParams->setInt32("vendor.qti-ext-vpp-aie.cade-level", cadeLevel);
+    sdkParams->setInt32("vendor.qti-ext-vpp-aie.ltm-ace-brightness-low", aceBrightnessLow);
+    sdkParams->setInt32("vendor.qti-ext-vpp-aie.ltm-ace-str", aceStrength);
+    sdkParams->setInt32("vendor.qti-ext-vpp-aie.ltm-sat-gain", satGainAndOffset);
+    sdkParams->setInt32("vendor.qti-ext-vpp-aie.ltm-sat-offset", satGainAndOffset);
+}
+
+// Stock QTI VPP AIS parameters: manual VPP mode with automatic
+// super-resolution on linear-color-decoded input.
+void addVideoAisParams(const sp<AMessage> &sdkParams) {
+    sdkParams->setInt32("vendor.ext-mi-sr-enable.value", 1);
+    sdkParams->setInt32("vendor.ext-mi-sr-bypass.value", 0);
+    sdkParams->setInt32("vendor.qti-ext-dec-linear-color-format.value", 1);
+    sdkParams->setInt32("vendor.qti-ext-vpp-lazy-init.on", 1);
+    sdkParams->setString("vendor.qti-ext-vpp.mode", "HQV_MODE_MANUAL");
+    sdkParams->setInt32("vendor.qti-ext-vpp-bypass.enable", 0);
+    sdkParams->setString("vendor.qti-ext-vpp-ais.mode", "AIS_AUTO");
+    sdkParams->setInt32("vendor.qti-ext-vpp-ais.bypass", 0);
+}
+
+// Applies exactly one feature's parameter set (or none) to this configuration.
+void addVideoEnhancementParams(
+        const sp<AMessage> &sdkParams,
+        VideoEnhancement feature,
+        int32_t width,
+        int32_t height) {
+    switch (feature) {
+        case VideoEnhancement::Memc:
+            addVideoMemcParams(sdkParams);
+            break;
+        case VideoEnhancement::Aie:
+            addVideoAieParams(sdkParams, width, height);
+            break;
+        case VideoEnhancement::Ais:
+            addVideoAisParams(sdkParams);
+            break;
+        case VideoEnhancement::None:
+            break;
+    }
+}
+
 }  // namespace
 
 // CCodec::ClientListener
@@ -1735,9 +2121,23 @@ void CCodec::configure(const sp<AMessage> &msg) {
         //       the behavior here.
         sp<AMessage> sdkParams = msg;
         int32_t videoBitrate;
-        if (sdkParams->findInt32(PARAMETER_KEY_VIDEO_BITRATE, &videoBitrate)) {
+        const bool hasVideoBitrate =
+                sdkParams->findInt32(PARAMETER_KEY_VIDEO_BITRATE, &videoBitrate);
+        int32_t enhancementWidth = 0;
+        int32_t enhancementHeight = 0;
+        const VideoEnhancement enhancement = selectVideoEnhancement(
+                comp, *config, msg, mime, &enhancementWidth, &enhancementHeight);
+        if (hasVideoBitrate || enhancement != VideoEnhancement::None) {
+            // sdkParams is modified below, so never touch the caller's message.
             sdkParams = msg->dup();
-            sdkParams->removeEntryAt(sdkParams->findEntryByName(PARAMETER_KEY_VIDEO_BITRATE));
+            if (hasVideoBitrate) {
+                sdkParams->removeEntryAt(sdkParams->findEntryByName(PARAMETER_KEY_VIDEO_BITRATE));
+            }
+        }
+        if (enhancement != VideoEnhancement::None) {
+            addVideoEnhancementParams(sdkParams, enhancement, enhancementWidth, enhancementHeight);
+            ALOGI("video enhancement: applying %s parameters to %s",
+                  videoEnhancementName(enhancement), comp->getName().c_str());
         }
         err = config->getConfigUpdateFromSdkParams(
                 comp, sdkParams, Config::IS_CONFIG, C2_DONT_BLOCK, &configUpdate);
-- 
