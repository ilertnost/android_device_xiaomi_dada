Date: Wed, 1 Jul 2026 08:58:42 +0900
Subject: [PATCH 2/2] CameraService: preserve advertised ten-bit capability

---
 .../common/CameraProviderManager.cpp          | 38 -------------------
 .../common/CameraProviderManager.h            |  1 -
 .../common/aidl/AidlProviderInfo.cpp          |  6 ---
 3 files changed, 45 deletions(-)

diff --git a/services/camera/libcameraservice/common/CameraProviderManager.cpp b/services/camera/libcameraservice/common/CameraProviderManager.cpp
index 249c538..fa468f8 100644
--- a/services/camera/libcameraservice/common/CameraProviderManager.cpp
+++ b/services/camera/libcameraservice/common/CameraProviderManager.cpp
@@ -1858,44 +1858,6 @@ status_t CameraProviderManager::ProviderInfo::DeviceInfo3::fixupManualFlashStren
     return res;
 }
 
-status_t CameraProviderManager::ProviderInfo::DeviceInfo3::removeTenBitDynamicRangeCapability() {
-    // If JPEG_R is disabled via property, remove DYNAMIC_RANGE_TEN_BIT capability
-    // to prevent apps from requesting unsupported JPEG_R streams
-    if (!kFrameworkJpegRDisabled) {
-        return OK;
-    }
-
-    auto& c = mCameraCharacteristics;
-    camera_metadata_entry_t caps = c.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
-    if (caps.count == 0) {
-        return OK;
-    }
-
-    std::vector<uint8_t> newCaps;
-    bool found = false;
-    for (size_t i = 0; i < caps.count; i++) {
-        if (caps.data.u8[i] == ANDROID_REQUEST_AVAILABLE_CAPABILITIES_DYNAMIC_RANGE_TEN_BIT) {
-            found = true;
-            ALOGI("%s: Removing DYNAMIC_RANGE_TEN_BIT capability (ro.camera.disableJpegR=true)",
-                    __FUNCTION__);
-        } else {
-            newCaps.push_back(caps.data.u8[i]);
-        }
-    }
-
-    if (found && !newCaps.empty()) {
-        status_t res = c.update(ANDROID_REQUEST_AVAILABLE_CAPABILITIES,
-                newCaps.data(), newCaps.size());
-        if (res != OK) {
-            ALOGE("%s: Failed to update capabilities: %s (%d)",
-                    __FUNCTION__, strerror(-res), res);
-            return res;
-        }
-    }
-
-    return OK;
-}
-
 status_t CameraProviderManager::ProviderInfo::DeviceInfo3::fixupMonochromeTags() {
     status_t res = OK;
     auto& c = mCameraCharacteristics;
diff --git a/services/camera/libcameraservice/common/CameraProviderManager.h b/services/camera/libcameraservice/common/CameraProviderManager.h
index 2299b98..a2231d6 100644
--- a/services/camera/libcameraservice/common/CameraProviderManager.h
+++ b/services/camera/libcameraservice/common/CameraProviderManager.h
@@ -779,7 +779,6 @@ private:
             status_t fixupMonochromeTags();
             status_t fixupTorchStrengthTags();
             status_t fixupManualFlashStrengthControlTags(CameraMetadata& ch);
-            status_t removeTenBitDynamicRangeCapability();
             status_t addDynamicDepthTags(bool maxResolution = false);
             status_t deriveHeicTags(bool maxResolution = false);
             status_t deriveJpegRTags(bool maxResolution = false);
diff --git a/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp b/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp
index 4d86a9f..8b66e4c 100644
--- a/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp
+++ b/services/camera/libcameraservice/common/aidl/AidlProviderInfo.cpp
@@ -586,12 +586,6 @@ AidlProviderInfo::AidlDeviceInfo3::AidlDeviceInfo3(
                 __FUNCTION__, strerror(-res), res);
         return;
     }
-    res = removeTenBitDynamicRangeCapability();
-    if (OK != res) {
-        ALOGE("%s: Unable to remove 10-bit dynamic range capability: %s (%d)",
-                __FUNCTION__, strerror(-res), res);
-        return;
-    }
     res = fixupManualFlashStrengthControlTags(mCameraCharacteristics);
     if (OK != res) {
         ALOGE("%s: Unable to fix up manual flash strength control tags: %s (%d)",
