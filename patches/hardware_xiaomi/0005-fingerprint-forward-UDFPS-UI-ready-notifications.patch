From 499fb13238daced165e95dbf70ce9e8ebe8c4c9f Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Sun, 12 Jul 2026 20:14:00 +0900
Subject: [PATCH 05/14] fingerprint: forward UDFPS UI-ready notifications


diff --git a/aidl/fingerprint/Session.cpp b/aidl/fingerprint/Session.cpp
index b935731..0de9f63 100644
--- a/aidl/fingerprint/Session.cpp
+++ b/aidl/fingerprint/Session.cpp
@@ -185,7 +185,9 @@ ndk::ScopedAStatus Session::onPointerUp(int32_t /*pointerId*/) {
 }
 
 ndk::ScopedAStatus Session::onUiReady() {
-    // TODO: stub
+    if (mUdfpsHandler) {
+        mUdfpsHandler->onUiReady();
+    }
 
     return ndk::ScopedAStatus::ok();
 }
diff --git a/fingerprint/include/UdfpsHandler.h b/fingerprint/include/UdfpsHandler.h
index 78f2368..9f33e55 100644
--- a/fingerprint/include/UdfpsHandler.h
+++ b/fingerprint/include/UdfpsHandler.h
@@ -20,6 +20,7 @@ class UdfpsHandler {
     virtual void init(fingerprint_device_t* device) {};
     virtual void onFingerDown(uint32_t x, uint32_t y, float minor, float major) {};
     virtual void onFingerUp() {};
+    virtual void onUiReady() {};
 
     virtual void onAcquired(int32_t result, int32_t vendorCode) {};
     virtual void onAuthenticationSucceeded() {};
