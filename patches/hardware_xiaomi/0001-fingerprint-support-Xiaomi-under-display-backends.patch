From 7bd208fb9a700186488f86ad81182ffd46f63844 Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Fri, 10 Jul 2026 08:06:46 +0900
Subject: [PATCH 01/14] fingerprint: support Xiaomi under-display backends


diff --git a/aidl/fingerprint/Android.bp b/aidl/fingerprint/Android.bp
index 5368db6..3d785ff 100644
--- a/aidl/fingerprint/Android.bp
+++ b/aidl/fingerprint/Android.bp
@@ -39,7 +39,6 @@ xiaomi_hardware_biometrics_config_default {
 
 cc_binary {
     name: "android.hardware.biometrics.fingerprint-service.xiaomi",
-    enabled: false, // Using prebuilt from vendor/xiaomi/sm8750-common instead
     defaults: ["xiaomi_hardware_biometrics_config_default"],
     relative_install_path: "hw",
     init_rc: ["android.hardware.biometrics.fingerprint-service.xiaomi.rc"],
diff --git a/aidl/fingerprint/Fingerprint.cpp b/aidl/fingerprint/Fingerprint.cpp
index 2edcf97..4465761 100644
--- a/aidl/fingerprint/Fingerprint.cpp
+++ b/aidl/fingerprint/Fingerprint.cpp
@@ -33,8 +33,9 @@ typedef struct fingerprint_hal {
 } fingerprint_hal_t;
 
 static const fingerprint_hal_t kModules[] = {
-        {"fortsense"},  {"fpc"},         {"fpc_fod"}, {"goodix"}, {"goodix:gf_fingerprint"},
-        {"goodix_fod"}, {"goodix_fod6"}, {"silead"},  {"syna"},
+        {"qcom_us"},    {"goodix_us"},  {"fortsense"}, {"fpc"},       {"fpc_fod"},
+        {"goodix"},     {"goodix:gf_fingerprint"},      {"goodix_fod"}, {"goodix_fod6"},
+        {"silead"},     {"syna"},
 };
 
 }  // namespace
diff --git a/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.xiaomi.rc b/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.xiaomi.rc
index 89d1c3e..6f63697 100644
--- a/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.xiaomi.rc
+++ b/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.xiaomi.rc
@@ -4,6 +4,6 @@ service vendor.fingerprint-default /vendor/bin/hw/android.hardware.biometrics.fi
     # /data is mounted.
     class late_start
     user system
-    group system input uhid
-    capabilities SYS_NICE
+    group system drmrpc diag input uhid
+    capabilities SYS_NICE WAKE_ALARM BLOCK_SUSPEND
     shutdown critical
