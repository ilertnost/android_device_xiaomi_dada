From 168a7a7a057d7381c7079f6a27221be46a2a2b03 Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Thu, 16 Jul 2026 20:12:52 +0900
Subject: [PATCH] Settings: fix MEP switching with duplicate slot mappings

---
 .../settings/network/UiccSlotUtil.java        | 19 ++++++-
 .../settings/network/UiccSlotUtilTest.java    | 50 ++++++++++++++++---
 2 files changed, 59 insertions(+), 10 deletions(-)

diff --git a/src/com/android/settings/network/UiccSlotUtil.java b/src/com/android/settings/network/UiccSlotUtil.java
index 3dcd388..53b6dac 100644
--- a/src/com/android/settings/network/UiccSlotUtil.java
+++ b/src/com/android/settings/network/UiccSlotUtil.java
@@ -271,9 +271,13 @@ public class UiccSlotUtil {
             }
             telMgr.setSimSlotMapping(uiccSlotMappings);
             latch.await(waitingTimeMillis, TimeUnit.MILLISECONDS);
-        } catch (InterruptedException | IllegalStateException | IllegalArgumentException e) {
+        } catch (InterruptedException e) {
             Thread.currentThread().interrupt();
             Log.e(TAG, "Failed switching to physical slot.", e);
+            throw new UiccSlotsException("Interrupted while switching to physical slot", e);
+        } catch (IllegalStateException | IllegalArgumentException e) {
+            Log.e(TAG, "Failed switching to physical slot.", e);
+            throw new UiccSlotsException("Failed switching to physical slot", e);
         } finally {
             if (receiver != null) {
                 context.unregisterReceiver(receiver);
@@ -324,6 +328,15 @@ public class UiccSlotUtil {
             Log.d(TAG, "There is no removedLogicalSlotId. Do nothing.");
             return uiccSlotMappings;
         }
+        boolean hasUnexpectedDuplicate = uiccSlotMappings.stream()
+                .filter(mapping -> mapping.getLogicalSlotIndex() != removedLogicalSlotId)
+                .collect(Collectors.groupingBy(UiccSlotMapping::getLogicalSlotIndex))
+                .values().stream()
+                .anyMatch(mappings -> mappings.size() > 1);
+        if (hasUnexpectedDuplicate) {
+            Log.e(TAG, "Unexpected duplicate logical slot mapping. Do nothing.");
+            return uiccSlotMappings;
+        }
         Log.d(TAG,
                 String.format(
                         "Create new SimSlotMapping. Remove the UiccSlotMapping of logicalSlot%d"
@@ -340,12 +353,14 @@ public class UiccSlotUtil {
                 uiccSlotMappings.stream()
                         .sorted(Comparator.comparingInt(UiccSlotMapping::getLogicalSlotIndex))
                         .collect(Collectors.toList());
+        boolean targetMappingAdded = false;
         for (UiccSlotMapping uiccSlotMapping : tempUiccSlotMappings) {
             if (uiccSlotMapping.getLogicalSlotIndex() == removedLogicalSlotId) {
-                if (!isPsim) {
+                if (!isPsim && !targetMappingAdded) {
                     // Replace this uiccSlotMapping
                     newUiccSlotMappings.add(new UiccSlotMapping(port, physicalSlotId,
                             uiccSlotMapping.getLogicalSlotIndex()));
+                    targetMappingAdded = true;
                 }
                 continue;
             }
diff --git a/tests/unit/src/com/android/settings/network/UiccSlotUtilTest.java b/tests/unit/src/com/android/settings/network/UiccSlotUtilTest.java
index 5615f4d..c6d9cf1 100644
--- a/tests/unit/src/com/android/settings/network/UiccSlotUtilTest.java
+++ b/tests/unit/src/com/android/settings/network/UiccSlotUtilTest.java
@@ -20,6 +20,7 @@ import static android.telephony.UiccSlotInfo.CARD_STATE_INFO_PRESENT;
 
 import static com.google.common.truth.Truth.assertThat;
 
+import static org.junit.Assert.assertThrows;
 import static org.mockito.ArgumentMatchers.any;
 import static org.mockito.Mockito.doThrow;
 import static org.mockito.Mockito.spy;
@@ -205,6 +206,33 @@ public class UiccSlotUtilTest {
         compareTwoUiccSlotMappings(testUiccSlotMappings, verifyUiccSlotMappings);
     }
 
+    @Test
+    public void prepareUiccSlotMappings_duplicateRemovedLogicalSlot_addsTargetOnce() {
+        Collection<UiccSlotMapping> uiccSlotMappings = new ArrayList<>();
+        uiccSlotMappings.add(new UiccSlotMapping(0, PSIM_PHYSICAL_SLOT, 0));
+        uiccSlotMappings.add(new UiccSlotMapping(1, PSIM_PHYSICAL_SLOT, 0));
+        uiccSlotMappings.add(new UiccSlotMapping(0, ESIM_PHYSICAL_SLOT, 1));
+        Collection<UiccSlotMapping> verifyUiccSlotMappings = createUiccSlotMappingDualPortsB();
+
+        Collection<UiccSlotMapping> testUiccSlotMappings = UiccSlotUtil.prepareUiccSlotMappings(
+                uiccSlotMappings, false, ESIM_PHYSICAL_SLOT, 1, 0);
+
+        compareTwoUiccSlotMappings(testUiccSlotMappings, verifyUiccSlotMappings);
+    }
+
+    @Test
+    public void prepareUiccSlotMappings_duplicateUnrelatedLogicalSlot_returnsOriginalMapping() {
+        Collection<UiccSlotMapping> uiccSlotMappings = new ArrayList<>();
+        uiccSlotMappings.add(new UiccSlotMapping(0, PSIM_PHYSICAL_SLOT, 0));
+        uiccSlotMappings.add(new UiccSlotMapping(0, ESIM_PHYSICAL_SLOT, 1));
+        uiccSlotMappings.add(new UiccSlotMapping(1, ESIM_PHYSICAL_SLOT, 1));
+
+        Collection<UiccSlotMapping> testUiccSlotMappings = UiccSlotUtil.prepareUiccSlotMappings(
+                uiccSlotMappings, true, PSIM_PHYSICAL_SLOT, 0, 0);
+
+        assertThat(testUiccSlotMappings).isSameInstanceAs(uiccSlotMappings);
+    }
+
     @Test
     public void prepareUiccSlotMappings_fromPsimAndPort1ToDualPortsA_dualPortsA() {
         Collection<UiccSlotMapping> uiccSlotMappings = createUiccSlotMappingPsimAndPort1();
@@ -633,25 +661,31 @@ public class UiccSlotUtilTest {
     }
 
     @Test
-    public void performSwitchToSlot_failedByIllegalState_noCrash()
-            throws UiccSlotsException {
+    public void performSwitchToSlot_failedByIllegalState_throwsUiccSlotsException() {
         Collection<UiccSlotMapping> uiccSlotMappings = createUiccSlotMappingDualPortsBNoOrding();
         doThrow(IllegalStateException.class).when(
                 mTelephonyManager).setSimSlotMapping(any());
 
-        UiccSlotUtil.performSwitchToSlot(mTelephonyManager, uiccSlotMappings, mContext);
-        // No crash
+        UiccSlotsException exception = assertThrows(UiccSlotsException.class,
+                () -> UiccSlotUtil.performSwitchToSlot(
+                        mTelephonyManager, uiccSlotMappings, mContext));
+
+        assertThat(exception).hasCauseThat().isInstanceOf(IllegalStateException.class);
+        verify(mContext).unregisterReceiver(any());
     }
 
     @Test
-    public void performSwitchToSlot_failedByIllegalArgument_noCrash()
-            throws UiccSlotsException {
+    public void performSwitchToSlot_failedByIllegalArgument_throwsUiccSlotsException() {
         Collection<UiccSlotMapping> uiccSlotMappings = createUiccSlotMappingDualPortsBNoOrding();
         doThrow(IllegalArgumentException.class).when(
                 mTelephonyManager).setSimSlotMapping(any());
 
-        UiccSlotUtil.performSwitchToSlot(mTelephonyManager, uiccSlotMappings, mContext);
-        // No crash
+        UiccSlotsException exception = assertThrows(UiccSlotsException.class,
+                () -> UiccSlotUtil.performSwitchToSlot(
+                        mTelephonyManager, uiccSlotMappings, mContext));
+
+        assertThat(exception).hasCauseThat().isInstanceOf(IllegalArgumentException.class);
+        verify(mContext).unregisterReceiver(any());
     }
 
     @Test
